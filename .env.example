# =============================================================================
# Angela AI - Environment Configuration (Example)
# =============================================================================
# 将此文件复制为 .env 并更新为您的设置
#
# 安装步骤:
# 1. 复制此文件: cp .env.example .env
# 2. 编辑 .env 文件，更新必需的配置
# 3. 验证配置（从项目根目录运行）:
#    python -c "import sys; sys.path.insert(0, 'apps/backend'); sys.path.insert(0, 'apps/backend/src'); from core.config_validator import validate; validate()"
# =============================================================================

# -----------------------------------------------------------------------------
# 应用设置
# -----------------------------------------------------------------------------
ANGELA_ENV=development          # 运行环境: development, production, testing（bootstrap 寫入 .env 時用這個名字）
NODE_ENV=development           # 供 Node/Next.js 自己讀取（本專案程式碼不讀它）
# 沒有 ANGELA_TESTING：這個名字除了 tests/integration/test_middleware.py 之外
# 沒有任何程式讀取，設定它不會進入任何測試模式。

# -----------------------------------------------------------------------------
# 后端配置
# -----------------------------------------------------------------------------
# 後端自己的 bind 位址是 ANGELA_SERVER_HOST / ANGELA_SERVER_PORT（見檔案末段
# 「服務綁定」），由 core/system/config/network_defaults.get_server_bind() 讀取。
# 舊的 BACKEND_HOST / BACKEND_PORT 兩個名字沒有任何程式讀取，留著只會讓人
# 以為設了就會生效，已移除。
BACKEND_URL=http://127.0.0.1:8000  # web-dashboard 的 server-side route 讀取 (process.env.BACKEND_URL)

# -----------------------------------------------------------------------------
# 安全密钥 (生产环境必须生成真实的密钥)
# -----------------------------------------------------------------------------
# 使用以下命令生成密钥: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 或运行: python -m apps.backend.src.core.security.key_generator
#
# 示例 (请勿直接使用):
# ANGELA_KEY_A=gAAAAABl-example-key-please-generate-your-own-key-here

# Left unset on purpose: a placeholder value on a key variable reads as usable.
# Generate your own pair with:
#   python -m apps.backend.src.core.security.key_generator
# ANGELA_KEY_A=
# ANGELA_KEY_B=
# ANGELA_KEY_C=

# -----------------------------------------------------------------------------
# 数据库配置
# -----------------------------------------------------------------------------
# 後端沒有資料庫層（唯一用到 sqlite3 的是 ai/meta/learning_log_db.py，它自己管
# 檔案路徑）。DATABASE_POOL_SIZE / DATABASE_MAX_OVERFLOW 是 SQLAlchemy 專用參數，
# 本專案沒有 SQLAlchemy，兩個都沒有消費者，已移除。
DATABASE_URL=sqlite:///./angela.db  # 後端目前不讀取；docker-compose.yml 會把它傳進 app 容器

# -----------------------------------------------------------------------------
# Live2D 配置
# -----------------------------------------------------------------------------
# 沒有 Live2D 環境變數：SDK CDN 由 renderer 自己硬編碼並逐個 fallback
# (packages/shared-js/js/live2d-cubism-wrapper.js)，模型路徑由桌面版設定存
# localStorage 決定。瀏覽器 / Electron renderer 讀不到 .env，這兩個變數在
# 程式碼中不存在，已移除。

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Google Gemini ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_API_KEY=your_ollama_api_key_here

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Rovo ─────────────────────────────────────────────────────────────────────
# 沒有 ROVO_API_KEY：Atlassian/Rovo 端點 (/api/v1/atlassian/rovo/agents) 的憑證
# 由請求帶入 (AtlassianBridge.set_config(domain, email, token))，不讀環境變數。

# ─── TensorFlow ───────────────────────────────────────────────────────────────
TF_USE_LEGACY_KERAS=true

# -----------------------------------------------------------------------------
# Angela Core (required)
# -----------------------------------------------------------------------------
ANGELA_HOME=./angela_home
ANGELA_LOG_LEVEL=INFO
ANGELA_CONFIG_DIR=./configs
ANGELA_DATA_DIR=./data
ANGELA_LLM_API_KEY=
ANGELA_LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 安全密钥
# -----------------------------------------------------------------------------
SECRET_KEY=generate_with_python_cryptography_Fernet_generate_key
HSP_ENCRYPTION_KEY=generate_with_python_cryptography_Fernet_generate_key
# 沒有 CONTEXT_ENCRYPTION_ENABLED / CONTEXT_ACCESS_CONTROL_ENABLED /
# CONTEXT_LOG_LEVEL：上下文加密是 ai.context.utils.encrypt_context_data(data, key)
# 的參數，沒有金鑰就不加密，沒有開關可切；存取控制與該模組的 log level 也沒有
# 對應實作。三個開關在程式碼中都不存在，已移除。

# -----------------------------------------------------------------------------
# 上下文存储配置
# -----------------------------------------------------------------------------
# 只有下面兩個是程式真的會讀的（Storage 建構參數的預設值）。其餘的
# CONTEXT_CACHE_ENABLED / CONTEXT_CACHE_MAX_SIZE / CONTEXT_COMPRESSION_ENABLED /
# CONTEXT_DATABASE_STORAGE_ENABLED / CONTEXT_DISK_STORAGE_ENABLED /
# CONTEXT_HAM_INTEGRATION_ENABLED / CONTEXT_MCP_INTEGRATION_ENABLED /
# CONTEXT_ASYNC_PROCESSING_ENABLED / CONTEXT_AUDIT_LOGGING_ENABLED 在
# ai/context 中沒有對應實作，已移除。
CONTEXT_STORAGE_DIR=./context_storage   # DiskStorage 的預設儲存目錄（與程式預設一致）
CONTEXT_MEMORY_MAX_SIZE=1000            # MemoryStorage 的預設 max_size（與程式預設一致）

# -----------------------------------------------------------------------------
# Angela 擴展配置
# -----------------------------------------------------------------------------
ANGELA_EXTENDED_MODEL=
ANGELA_VECTOR_BACKEND=auto
ANGELA_SKIP_EXTERNAL_DICTS=false
# Code default: os.getcwd() — file operations resolve against the working
# directory. Setting this to ./workspace would silently redirect every file
# operation into that subdirectory, so it stays unset here.
# ANGELA_WORKSPACE=
ANGELA_HARDWARE_PROFILE=auto

# -----------------------------------------------------------------------------
# 服務端點 (本地服務)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# 沒有 STABLE_DIFFUSION_URL：影像產生的端點是 ANGELA_SD_API_URL（見檔案末段），
# 由 core/life/self_generation.py 以 config > env > 慣例預設值的順序解析。

# -----------------------------------------------------------------------------
# Docker 密碼 (生產環境請修改)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=change_me_in_production
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# -----------------------------------------------------------------------------
# CORS (生產環境請限制為具體域名，逗號分隔)
# -----------------------------------------------------------------------------
# ANGELA_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# 默認 "*" 僅適用本地開發；當配置具體域名時自動啟用 credentials

# -----------------------------------------------------------------------------
# 開發設置
# -----------------------------------------------------------------------------
# 沒有 DEBUG_MODE / LOG_LEVEL：這兩個名字只被已棄用的 core/config/system_config.py
# 讀取（該模組標頭載明 0 active imports），設定它們不會改變任何行為；本檔案原本
# 還寫著 “the project uses DEBUG_MODE”，實際上沒有任何消費者。真正的 log 級別是
# ANGELA_LOG_LEVEL（見上方 Angela Core 區塊）。
# hsp/security.py 會讀 TESTING_MODE 放寬簽章檢查，預設 false。
TESTING_MODE=false

# =============================================================================
# Runtime settings that were read by the code but missing from this file
# =============================================================================
# Audit finding: 47 environment variables were read somewhere under
# apps/backend/src with no entry here, so a fresh install had no documented value
# — and no way to discover the switch. Every default below is the one the code
# actually uses (apps/backend/src), not a guess. Uncomment to override.
#
# Guarded by tests/test_env_defaults.py: an env var read by the code but absent
# from this file fails the suite, and a default that disagrees with the code fails
# too.

# --- server bind address -----------------------------------------------------
# Default 0.0.0.0 in code. Set to 127.0.0.1 to refuse connections from the LAN.
# Code default: 0.0.0.0 (SERVER_BIND_HOST). Set to 127.0.0.1 to refuse LAN
# connections.
ANGELA_SERVER_HOST=0.0.0.0
ANGELA_SERVER_PORT=8000
# Comma-separated; code default is 127.0.0.1,::1,localhost
# ANGELA_TRUSTED_HOSTS=127.0.0.1,::1,localhost

# --- feature switches (all default to "off" unless noted) --------------------
# Set to 1 to enable the legacy ED3N/GARDEN trainers. Off by default: they are
# opt-in because they cost real compute.
# ANGELA_LEGACY_ED3N=1
# Force every LLM route to a local backend regardless of health checks.
# ANGELA_FORCE_LOCAL=1
# Routing engine: 1 = the multi-hop engine, 0 = the single-pass path.
ANGELA_ROUTING_ENGINE=1
# Minimum 4 is enforced by the engine.
# Code default: 12 (MAX_HOPS_PER_REQUEST in services/llm/routing/engine.py); the
# engine enforces a floor of 4.
ANGELA_ROUTING_MAX_HOPS=12
# REPL lifecycle tweaks (digital_life_integrator).
# ANGELA_REPL_MODE=1
# Disable the HAM vector store when running without the vector extras.
# Code default: 0 (enabled). Set to 1 only when running without the vector extras.
# HAM_DISABLE_VECTOR_STORE=1
# Desktop session marker; set by the desktop launcher, not by hand.
# DESKTOP_SESSION=1

# --- paths -------------------------------------------------------------------
# Repo root; inferred from this file's location when unset.
# ANGELA_PROJECT_ROOT=/home/you/Unified-AI-Project
# Model directory for GARDEN; defaults to the repo's models/ tree.
# ANGELA_MODELS_DIR=./models
# Vector store location; defaults to data/vector_store/.
# VECTOR_STORE_PATH=./data/vector_store
DATA_PATH=./data
MODEL_PATH=./models
# Where generated images are written.
# Code default: data/generated_images
# ANGELA_IMAGE_OUTPUT_DIR=data/generated_images
# Code default: ~/.cache/huggingface
# HF_HOME=~/.cache/huggingface

# --- prompt budget -----------------------------------------------------------
# Empty means "use the model's own context window" (llama.cpp runs at 4096).
# Set a number to cap the prompt, e.g. 2048.
# ANGELA_PROMPT_TOKEN_BUDGET=

# --- storage / datastores ----------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Embedding width of the vector store. Changing it invalidates existing
# collections: 384 is the default the store was built with.
VECTOR_DIMENSION=384

# --- learning / training knobs ----------------------------------------------
BATCH_SIZE=32
CHECKPOINT_INTERVAL=100
MIN_DATA_POINTS=100
PREDICTION_WINDOW=24
ANOMALY_THRESHOLD=0.1
MAX_MEMORY_SIZE=10000
AUTO_TRAINING=true
AUTO_HEALING=true
AI_OPS_ENABLED=true
HSP_ENABLED=true
PERFORMANCE_MONITORING=true
MONITORING_INTERVAL=300
# Seconds allowed for the GARDEN import self-probe before it is treated as slow.
# GARDEN_IMPORT_PROBE_TIMEOUT=30

# --- MQTT (HSP agent transport) ---------------------------------------------
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
# MQTT_USERNAME=
# MQTT_PASSWORD=

# --- external services (leave empty to keep the feature off) -----------------
# GOOGLE_API_KEY=
ANGELA_SD_API_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
ANGELA_DRIVE_API_URL=

# --- security ----------------------------------------------------------------
# ENCRYPTION_KEY=            # generate your own; do not reuse a committed value
UNIFIED_AI_ENV=development

# --- EDA / chip verification (optional; each is auto-discovered when present) --
# ANGELA_SKY130_MAGIC_TECH=   # path to sky130A.tech; enables layout DRC + extraction
# ANGELA_SKY130_SPICE_LIBRARY= # sky130 SPICE model file; enables extracted-netlist
#                             # simulation. Must be a file that actually defines
#                             # sky130_fd_pr__nfet_01v8; the volare all.spice pulls its
#                             # models in by relative include and does not work
#                             # when handed to ngspice directly.

# ANGELA_SKY130_FLAT_SPICE=    # flattened nfet+pfet model file built from the volare
#                             # corner cards. The layout work needs both device types
#                             # in one file, which no single volare file provides.
#                             # See ai.hardware.cim_toolchain.MODEL_LIBRARY.
# VOLARE_ROOT=                 # root of the volare sky130 install; the layout tools
#                             # search it for */sky130A/libs.tech/magic/sky130A.tech
#                             # instead of a hardcoded version path.
